# Database Configuration
DATABASE_URL=postgresql+psycopg2://statementiq:statementiq@db:5432/statementiq

# Application & Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
STATEMENTIQ_API_KEY=your_optional_api_key_here

# API & UI URLs
API_URL=http://localhost:8000

# OCI Generative AI Settings
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
OCI_MODEL_ID=ocid1.generativeaimodel.oc1..example
